class PlayerSettingsScreen(private val mainSettings: Boolean) : Screen() {
    @Composable
    override fun Content() {
        val parentNavigator = LocalNavigator.currentOrThrow
        if (!isTabletUi()) {
            Navigator(
                screen = PlayerSettingsMainScreen(mainSettings),
