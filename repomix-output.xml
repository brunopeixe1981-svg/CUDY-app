        Anime.EPISODE_SORTING_ALPHABET -> when (sortDescending) {
            true -> { e1, e2 -> e2.name.compareToWithCollator(e1.name) }
            false -> { e1, e2 -> e1.name.compareToWithCollator(e2.name) }
        }
