        prefs.edit {
            putInt("pref_default_orientation_type_key", newOrientation)
            remove("pref_rotation_type_key")
            putInt("pref_default_reading_mode_key", newReadingMode)
            remove("pref_default_viewer_key")
        }

        return true
    }
}
