            DropdownMenu(
                expanded = isDropDownExpanded.value,
                onDismissRequest = {
                    isDropDownExpanded.value = false
                },
            ) {
                values.forEach { item ->
                    DropdownMenuItem(
                        text = {
                            Text(text = stringResource(item.stringRes))
                        },
                        onClick = {
                            isDropDownExpanded.value = false
                            onSelect(item)
                        },
                    )
                }
            }
        }
    }
}
